{
  "name": "codegraph-memory",
  "version": "0.1.0",
  "description": "Long-term memory for coding agents — facts about your codebase (decisions, constraints, APIs, bugs) stored locally as JSON, recalled by BM25-lite scoring. No vector DB, no server, zero runtime deps.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent-memory",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "cursor",
    "llm",
    "knowledge-base",
    "code-search",
    "local-first",
    "developer-tools"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codegraph": "./cli/index.mjs"
  },
  "files": [
    "lib",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/memory.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
